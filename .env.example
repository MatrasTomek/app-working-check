# Dane logowania. Skopiuj do .env (nie commituj!) i uzupełnij.
# Konwencja: dla `login: PREFIX` w apps.yaml skrypt czyta PREFIX_USER i PREFIX_PASS.
PANEL_USER=
PANEL_PASS=

# Opcjonalnie: token GitHub dla `python check.py --github KONTO` — prywatne repozytoria
# i limit 5000 zapytań/h zamiast 60. Wystarczy token tylko do odczytu (patrz README).
GITHUB_TOKEN=

# --- Dashboard (python serve.py) ---
# Token dostępu (min. 32 znaki). Wygeneruj: python serve.py --gen-token
DASHBOARD_TOKEN=
# Nazwa hosta z Tailscale (np. komputer.tailnet-xxxx.ts.net), z której otwierasz dashboard na telefonie.
# Kilka nazw — po przecinku. localhost i 127.0.0.1 są zawsze dozwolone.
DASHBOARD_ALLOWED_HOSTS=
# Konta GitHub dla modułu Projekty (po przecinku).
DASHBOARD_GITHUB=
# Port (domyślnie 8765). Dashboard zawsze słucha tylko na 127.0.0.1.
DASHBOARD_PORT=8765
